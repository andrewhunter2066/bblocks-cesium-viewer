{
  "name": "@ogc/bblocks-cesium-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "bblocks-viewer view plugin rendering topo-feature (ogcincubator/topo-feature) topology documents on a CesiumJS globe.",
  "main": "./src/js/index.js",
  "exports": "./src/js/index.js",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-cesium-version.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/js/**/*.test.js\"",
    "local-register": "node scripts/use-local-plugin.mjs"
  },
  "devDependencies": {
    "@ogc/bblocks-viewer-plugin-types": "github:ogcincubator/bblocks-viewer-plugin-types",
    "cesium": "1.145.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}
